:false},{"id":"0000-0018","text":"부정할 수 없는 사실이고 분명히 있지만","start":57.900001525878906,"end":60.70000076293945,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0019","text":"그거는 우리가 사실 쓸데없잖아요.","start":60.70000076293945,"end":63.5,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0020","text":"알고 있다고 해도","start":63.5,"end":64.5,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0021","text":"우리 강아지는 다를 것 같아요.","start":64.5,"end":66.19999694824219,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0022","text":"네, 그럼요.","start":66.19999694824219,"end":68.4000015258789,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0023","text":"바꿀 수 없는 사실이니까","start":68.4000015258789,"end":69.9000015258789,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0024","text":"우리는 관리해서 바꿀 수 있는 수명에 집중하면 좋겠습니다.","start":69.9000015258789,"end":74.30000305175781,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0025","text":"그러면 보호자분들이 좀 무심코 하는 실수 중에","start":74.30000305175781,"end":77.5,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0026","text":"강아지들의 수명을 단축시키는 그런 실수들이 있을까요?","start":77.5,"end":81.5999984741211,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0027","text":"제일 좀 잦은 거는","start":81.5999984741211,"end":83.9000015258789,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0028","text":"양치 안 시키는 게 수명이랑 연관될 수 있다는 생각을","start":83.9000015258789,"end":88.19999694824219,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0029","text":"잘 못하시는 것 같아요.","start":88.19999694824219,"end":89.80000305175781,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0030","text":"그냥 양치를 안 시키면","start":89.80000305175781,"end":91.80000305175781,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0031","text":"구간 건강에만 문제가 있을 거다.","start":91.80000305175781,"end":94.80000305175781,"timestamp_status":null,"boundary_overlap":false},{"id":"0000-0032","text":"입냄새 좀 
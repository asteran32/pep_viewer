undary_overlap":false},{"id":"0001-0005","text":"에프토와 에피코르를 추가하고 알카리 육업을 추가해서","start":151.0,"end":158.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0006","text":"구연산화, 중조라는 베이킹소다, 식소다라고 하는 시중소다를 추가했어요.","start":158.0,"end":166.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0007","text":"하루에 케이지당 0.5mg을 먹여요.","start":166.0,"end":171.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0008","text":"그리고 암치료에 있어서 많은 역할을 하는 멜라토닌이란 물질을 추가했어요.","start":171.0,"end":177.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0009","text":"멜라토닌은 뇌의 송과선에서 분비되는 일종의 호르몬인데 당과 연관되어 있어요.","start":177.0,"end":184.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0010","text":"잠이 안 올 때 먹습니다.","start":184.0,"end":187.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0011","text":"고양이와 강아지, 반려동물도 멜라토닌을 먹습니다.","start":187.0,"end":193.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0012","text":"이 멜라토닌은 빛으로 조절이 되고","start":193.0,"end":197.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0013","text":"거의 모든 암에 대하여서 항암작용을 극대화해주는 효능이 있어요.","start":197.0,"end":203.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0014","text":"암 예방과 치료도 하지만 친해병으로 한다고 하네요.","start":203.0,"end":207.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0015","text":"면역력과 항산화 능력도 있으며","start":207.0,"end":211.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0016","text":"진행성 암에 대한 염령효과가 있어요.","start":211.0,"end":214.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0017","text":"살암 기준 1일 10-20mg이 암에 대한 예방 고용량입니다.","start":214.0,"end":220.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0018","text":"암치료에는 1일 10mg-40mg이 주로 사용되었고","start":220.0,"end":226.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0019","text":"치료용으로 메가도스하여 40mg-100mg까지도 들여서 많이들 먹어요.","start":226.0,"end":233.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0020","text":"고양이, 동미는 암치료를 위해서","start":233.0,"end":236.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0021","text":"대사 보도대로 멜라토닌은 하루 1.5g씩 먹습니다.","start":236.0,"end":240,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0000","text":"멜라토닌을 하루 1.5g을 먹이기 시작했어요.","start":238,"end":242.0,"timestamp_status":null,"boundary_overlap":true},{"id":"0002-0001","text":"멜라토닌의 효능은","start":242.0,"end":245.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0002","text":"고소흡색, 악의 질개선, 혈사의 부작용, 신경상해 등의 안부작용에 고운 효과가 있다고 합니다.","start":245.0,"end":255.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0003","text":"유방암, 폐암, 대장암, 뇌동양의 좋은 암,","start":255.0,"end":260.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0004","text":"단 면역세포 중연, 자가 면역질환은 허용돈지,","start":260.0,"end":265.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0005","text":"식소다와 구연사는 암 알카리 육업이라고 보면 됩니다.","start":265.0,"end":271.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0006","text":"식소다와 식종 구연사는 조합이 쉽고,","start":271.0,"end":275.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0007","text":"식소다는 마트에서 60g이 400원입니다.","start":275.0,"end":279.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0008","text":"식소다, 중탄산 나트륨이 암세포의 전의를 차단한다고 하는 동물실험 결과가 있고,","start":279.0,"end":287.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0009","text":"구연사는 제사를 활성화하고,","start":287.0,"end":290.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0010","text":"체액을 알카리로 하는 효과로 먹이기 시작했어요.","start":290.0,"end":295.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0011","text":"사람의 경우 5-10g에서 유효한 결과를 보고 있고,","start":295.0,"end":300.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0012","text":"치료용으로 10-15g정도가 차단하다고 보고 있습니다.","start":300.0,"end":306.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0013","text":"고양이와 소염병은 1kg당 0.5mg정도가 차단할 겁니다.","start":306.0,"end":312.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0014","text":"단, 구연산과 베이킹소다는 같이 먹으면 손아프에요.","start":312.0,"end":317.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0015","text":"구연산의 효과가 없어져서 따로 먹어야 합니다.","start":317.0,"end":321.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0016","text":"암치료의 크긴 효과는 작아도 간접적으로,","start":321.0,"end":325.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0017","text":"암수직의 산성화를 중화하는 작용을 기대하며,","start":325.0,"end":330.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0018","text":"대사암치료의 칵테일 육업이나 다양한 보사부 소재들이 섞여서,","start":330.0,"end":335.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0019","text":"암세포에게 지속적인 스트레스와 압력을 가할 것입니다.","start":335.0,"end":340.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0020","text":"고양이 동위는 당분간 암치료를 목적으로,","start":340.0,"end":345.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0021","text":"아침에 멜벤다졸신형인 안테닝 뽑기를 한 할 번역에는,","start":345.0,"end":350.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0022","text":"사람들이 먹는 플루벤다졸 성분을 80mg-100mg 알콩으로 먹일 예정입니다.","start":350.0,"end":359.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0000","text":"고양이 동이는 암치료를 위해서 기존에 먹던 항암의 좋은 대사보소제들은 그대로 먹고 있으며","start":358,"end":368.0,"timestamp_status":null,"boundary_overlap":true},{"id":"0003-0001","text":"몇가지 대사보소제를 더 주문해서 부착하는 대로 추가할 예정이며 교체할 것들은 교체할 겁니다.","start":368.0,"end":377.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0002","text":"멜벤다졸과 펜벤다졸이 암세포에 대하여서 미세소광화계와 포도당섭취업체 그리고 PO13 단백질 안정화를 시키고","start":377.0,"end":390.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0003","text":"클루벤다졸 성분은 스페프3 억제와 암줄기세포 억제를 하면서 암줄기세포를 공격하는 암세포에 대하여는 5가지 작용을 합니다.","start":390.0,"end":404.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0004","text":"한가지 종류 벤지니다졸 계열만 먹이는 것보다 암세포에 대한 공격을 더 넓히는 겁니다.","start":404.0,"end":413.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0005","text":"끝으로 고양이 동이에 암치료의 효과를 높이기 위해서 btf 크롬을 추가했어요.","start":413.0,"end":421.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0006","text":"크롬은 당뇨에 좋아요. 크롬은 미네랄이고 당뇨치료제이기도 합니다. 당뇨에 좋은 것들이 암치료가 됩니다.","start":421.0,"end":432.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0007","text":"포도당 대사를 막아서 암에게의 영양분을 차단시키는 것이라고 하면 이해가 쉽습니다.","start":432.0,"end":440.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0008","text":"크롬은 사람들이 200마이크로그램 중 꼰만큼 먹는데 고양이는 아주아주 적게 먹어요.","start":440.0,"end":449.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0009","text":"사람의 입술에 씻이 불량으로 20마이크로그램은 눈에 보일락 말락 하는데","start":449.0,"end":456.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0010","text":"영국의 제이는 이 크롬을 중요한 암치료에 대한 대사보도제라고 하였습니다.","start":457.0,"end":464.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0011","text":"마침 집에 크롬이 남아있어서 즉시 추가했어요.","start":464.0,"end":469.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0012","text":"주의할 점은 크롬은 무기질이라서 꼭 당량을 먹어야지 욕심을 내서 더 먹으면 심장에 부담이 옵니다.","start":469.0,"end":479.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0000","text":"모든 무기들은 딱 정량을 먹을 때 부작용이 없고 효과가 가장 좋아요.","start":478,"end":484.0,"timestamp_status":null,"boundary_overlap":true},{"id":"0004-0001","text":"기저귀의 암치료법은 고양이는 물론 강아지에게도 똑같이 적용하고 아주 안전하고 효과는 좋아요.","start":484.0,"end":493.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0002","text":"사람들 대사암치료법과도 동일한데 반려동물에게 먹일 수 있는 대사고도대들만을 사용해요.","start":497.0,"end":505.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0003","text":"암과 정량을 치료하는 고양이 강아지는 꼭 세상의 모든 고양이 탑재해보세요.","start":506.0,"end":512.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0004","text":"기저귀의 암치료법 동일 프로포폴을 공유합니다.","start":512.0,"end":516.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0005","te
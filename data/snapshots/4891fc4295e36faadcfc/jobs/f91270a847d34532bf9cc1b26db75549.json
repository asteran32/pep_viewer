1,"end":337.5,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0032","text":"브로콜리는 설포라판이라는 성분이 있는데","start":337.5,"end":340.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0033","text":"이게 체내 해독 효소를 활성화해서","start":340.0,"end":343.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0034","text":"바람 물질을 무력하게 만듭니다.","start":343.0,"end":344.6999969482422,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0035","text":"반드시 살짝 데쳐서 주세요.","start":344.6999969482422,"end":346.3000030517578,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0036","text":"생으로 많이 주면 갑상선에 영향을 줄 수 있어요.","start":346.3000030517578,"end":349.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0037","text":"그래서 이거는 하루에 5g 정도 주시면 좋고","start":349.0,"end":352.5999984741211,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0038","text":"마지막은 시금치입니다.","start":352.5999984741211,"end":354.0999984741211,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0039","text":"시금치","start":354.0999984741211,"end":355.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0040","text":"시금치는 비타민 C, 비타민 E, 베타카론인이 동시에 들어있어서","start":355.0,"end":359.4000015258789,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0041","text":"면역세포를","start":359.4000015258789,"end":360,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0000","text":"동시에 들어있어서 면역세포를 활성화하고","start":358,"end":360.75999999046326,"timestamp_status":null,"boundary_overlap":true},{"id":"0003-0001","text":"체내의 활성산소를 제거해줘요.","start":360.75999999046326,"end":362.55999994277954,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0002","text":"활성산소가 쌓이면은 만성염증과 암으로 이어진다는","start":362.55999994277954,"end":366.23999977111816,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0003","text":"그 연구가 정말 많아요.","start":366.23999977111816,"end":368.3999996185303,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0004","tex
0009536743,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0002","text":"칼륨이 과다해져서 심장에 무리가 오고","start":484.90000009536743,"end":487.3999996185303,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0003","text":"심하면은 근육마비나 호흡곤란까지 올 수가 있다고 해요.","start":487.3999996185303,"end":491.1000003814697,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0004","text":"효과를 보려면은 먹으면 안 되는 양까지 먹어야 하는 상황인 거죠.","start":491.1000003814697,"end":495.70000076293945,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0005","text":"영양제 하나로 해결한 게 이런 이유입니다.","start":495.70000076293945,"end":498.29999923706055,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0006","text":"우리 강아지도 똑같아요.","start":498.29999923706055,"end":499.6000003814697,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0007","text":"매일 이 음식들 챙겨주시는 게 쉽지 않다는 거 저도 알고 있습니다.","start":499.6000003814697,"end":503.70000076293945,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0008","text":"그리고 챙겨주셔도 효과를 보려면은 현실적으로 한계도 있고요.","start":503.70000076293945,"end":507.70000076293945,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0009","text":"그래서 제가 영양제를 찾아보시는 분들을 위해서 따로 영상을 만들어뒀어요.","start":507.70000076293945,"end":512.5,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0010","text":"비싼 반려동물 영양제 안 사도 됩니다.","start":512.5,"end":515.0999984741211,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0011","text":"비싸지 않게 매일 편하게 챙겨줄 수 있는 방법","start":515.0999984741211,"end":517.7999992370605,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0012","text":"아래 영상에 고정 댓글 있으니까 이어서 한번 보실 수 있습니다.","start":517.7999992370605,"end":521.5,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0013","text":"그리고 이 영상에는 무려 12만원 상당의 유산균을","start":521.5,"end":525.2000007629395,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0014","text":"선착순 100분에게 드리는 내용이 포함되어 있어요.","start":525.2000007629395,"end":528.2999992370605,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0015","text":"꼭 놓치지 말고 가져가세요.","start":528.2999992370605,"end":529.7000007629395,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0016","text":"오늘 이 긴 영상을 끝까지 봐주셨다는 거는","start":529.7000007629395,"end":532.9000015258789,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0017","text":"그게 이미 우리 아이를 위한 행동이었을 겁니다.","start":532.9000015258789,"end":535.7999992370605,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0018","text":"사실 오늘 영상 보시면서","start":535.7999992370605,"end":537.5999984741211,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0019","text":"그동안 사료만 먹였는데 다른 것도 좀 챙겨줄걸","start":537.5999984741211,"end":540.7000007629395,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0020","text":"이런 마음이 드신 분들 계실 것 같아요.","start":540.7000007629395,"end":542.6999969482422,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0021","text":"다 못 챙겨주셔도 괜찮습니다.","start":542.6999969482422,"end":544.5,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0022","text":"오늘 10가지 중에 하나라도 냉장고에서 꺼내주시는 것","start":544.5,"end":547.6999969482422,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0023","text":"그게 바로 시작입니다.","start":547.6999969482422,"end":548.6999969482422,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0024","text":"저도 보호자님들의 반려견을 위해서","start":548.6999969482422,"end":551.0999984741211,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0025","text":"더 좋은 정보를 가지고 오겠습니다.","start":551.0999984741211,"end":552.9000015258789,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0026","text":"놓치지 않도록 구독 눌러주시고요.","start":552.9000015258789,"end":555.0999984741211,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0027","text":"우리 아이와 함께하실 수 있는 시간","start":555.0999984741211,"end":557.1999969482422,"timestamp_status":null,"boundary_overlap":false},{"id":"0004-0028","text":"오늘 이 영상 하나로 조금 더 늘어났으면 좋겠
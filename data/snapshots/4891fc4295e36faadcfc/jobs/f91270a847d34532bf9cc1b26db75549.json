17","text":"사실 그만큼 주면은 당분 과다로 혈당에 부담이 생겨요.","start":409.4199981689453,"end":414.4199981689453,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0018","text":"이 당근도 마찬가지입니다.","start":414.4199981689453,"end":416.2200012207031,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0019","text":"당근도 히알루론산 효과를 체감할 만큼 먹이려면은","start":416.2200012207031,"end":419.7200012207031,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0020","text":"권장보다 훨씬 많은 양이 필요한데","start":419.7200012207031,"end":422.12000274658203,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0021","text":"그 당분이랑 칼로리도 함께 늘어나는 것도 있지만","start":422.12000274658203,"end":425.8199996948242,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0022","text":"이 비타민 A가 너무 많이 있어서","start":425.8199996948242,"end":427.5199966430664,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0023","text":"비타민 A는 몸속에 쌓이는 지용성 비타민이거든요.","start":427.5199966430664,"end":430.2200012207031,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0024","text":"그래서 강아지 몸에 매일 쌓이면은 좋지가 않아요.","start":430.2200012207031,"end":432.5199966430664,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0025","text":"이 10가지 음식들이 전부 다 비슷합니다.","start":432.5199966430664,"end":436.3199996948242,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0026","text":"권장량을 지켜야 안전하지만 효과가 좀 부족하고","start":436.3199996948242,"end":439.9199981689453,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0027","text":"효과를 보려면은 권장량을 훨씬 넘겨야 되는데","start":439.9199981689453,"end":443.12000274658203,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0028","text":"그러면은 다른 문제가 생깁니다.","start":443.12000274658203,"end":445.5199966430664,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0029","text":"이게 음식으로 영양을 채워주려고 할 때 생기는 구조적인 딜레마예요.","start":445.5199966430664,"end":449.4199981689453,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0030","text":"그러면은 이 음
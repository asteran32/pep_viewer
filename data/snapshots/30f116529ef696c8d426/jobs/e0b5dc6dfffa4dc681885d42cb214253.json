_overlap":false},{"id":"0002-0030","text":"담낭이 안 좋은 환자에 대해서 알아보려고 합니다","start":321.36000061035156,"end":324.1600036621094,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0031","text":"담낭이라고 하는 것은","start":324.1600036621094,"end":325.4800033569336,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0032","text":"간에서 생성된 담즙이 저장되는 저장소로서의 역할을 하는 건데요","start":325.4800033569336,"end":329.95999908447266,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0033","text":"이 담낭에 혹은 담간에 돌이 생기는 것을 담석이라고 하고","start":329.95999908447266,"end":335.12000274658203,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0034","text":"혹은 거기 찌꺼기들이 생기는 것을","start":335.12000274658203,"end":337.12000274658203,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0035","text":"담낭 찌꺼기, 담낭 슬러지 이렇게 표현을 하게 되고요","start":337.12000274658203,"end":340.87999725341797,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0036","text":"이로 인해서 담낭에 있는 담즙이 잘 배출되지 않는 것을","start":340.87999725341797,"end":344.9199981689453,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0037","text":"우리는 담즙울체라고 부릅니다","start":344.9199981689453,"end":347.9199981689453,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0038","text":"자 이렇게 되면은 이 담즙이란 건","start":347.9199981689453,"end":350.12000274658203,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0039","text":"지방을 소화하는 데 도와주는 그러한 액이라고 보시면 되는데요","start":350.8399963378906,"end":354.8399963378906,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0040","text":"결국 이게 제대로 배출이 되지 않고 방해를 받게 되면","start":354.8399963378906,"end":358.7200012207031,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0041","text":"결국은 지방을","start":358.7200012207031,"end":359.95999908447266,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0000","text":"결국은 지방을 잘 분해하지 못하는 그런 상황이 됩니다","start":358,"end":363.05999994277954,"timestamp_status":null,"boundary_overlap":true},{"id":"0003-
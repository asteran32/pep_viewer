,"boundary_overlap":false},{"id":"0001-0011","text":"어떻게 먹어야 하나요?","start":188.0,"end":190.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0012","text":"투야 기준 5kg 이하 소형견은","start":190.0,"end":195.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0013","text":"25-50mg, 10kg 이상 반려견은","start":196.0,"end":201.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0014","text":"50-100mg 하루 1회.","start":201.0,"end":205.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0015","text":"직후 투약.","start":205.0,"end":207.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0016","text":"복용방법은","start":207.0,"end":209.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0017","text":"약을 쪼개서 간식에 숨겨도 좋고","start":209.0,"end":212.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0018","text":"잘게 부순 뒤 물 3-5ml에 녹여","start":212.0,"end":217.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0019","text":"주사기로 천천히 입 옆으로 먹여도 되고","start":217.0,"end":221.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0020","text":"먹기 거부 시에는 삶은 닭가슴살 사이에 끼워","start":221.0,"end":225.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0021","text":"투약하는 것도 좋아요.","start":225.0,"end":228.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0022","text":"그럼 복용기간은 보통 3일에서 5일 이내 복용하고","start":228.0,"end":234.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0001-0023","text":"효과 없으면 다른 원인을 찾아야 해요.","start":234.0,"end":239.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0000","text":"약을 먹이고 하루, 이틀 아무 일도 없었어요.","start":238,"end":245.0,"timestamp_status":null,"boundary_overlap":true},{"id":"0002-0001","text":"그런데 3일째 되는 날 아침 강아지 눈빛이 바뀌었어요.","start":245.0,"end":251.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0002","text":"닭들은 앞에 앉아있는 모습 진짜 오랜만에 보게 되죠.","start":251.0,"end":257.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0003","text":"그리고 천천히, 아주 천천히 한 입을 먹기 시작했어요.","start":257.0,"end":264.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0004","text":"가장 작은 약이 가장 큰 희망이 될 수 있어요.","start":265.0,"end":269.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0005","text":"덴포티아민은 간 수치를 낮춰주지도 않고 염증을 치료하지도 않아요.","start":269.0,"end":276.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0006","text":"하지만 가장 작은 단위로 남은 에너지를 일으켜주는 기적같은 시작이 될 수 있어요.","start":276.0,"end":285.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0007","text":"강아지가 아프기 전까지는 절대 몰랐죠.","start":285.0,"end":290.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0008","text":"비타민 하나가 강아지의 눈빛을 되돌려줄 수 있다는 걸요?","start":290.0,"end":295.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0009","text":"비타민이라고 가볍게 넘기지 마세요.","start":295.0,"end":299.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0010","text":"사랑은 작아보이는 것 안에 숨어 있을 때가 많습니다.","start":299.0,"end":304.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0011","text":"그리고 보호자들이 알아야 할 것이 있습니다.","start":304.0,"end":308.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0012","text":"덴포티아민은 동물병원과 약국에서 가격 차이가 꽤 큰 약 중 하나입니다.","start":308.0,"end":316.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0013","text":"그래서 보호자가 몰라서 손해보는 대표적인 약이기도 하지요.","start":317.0,"end":324.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0014","text":"병원에서 검사비까지 10만 원을 냈지만 그게 사랑의 값이라고 생각하는 보호자들이 많아요.","start":324.0,"end":334.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0015","text":"하지만 집에서 직접 준비하면 하루 100원이면 충분해요.","start":334.0,"end":341.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0016","text":"모르면 손해입니다.","start":341.0,"end":343.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0017","text":"덴포티아민은 강아지가 아프다고 말하기엔 너무 미묘한 그 작은 힘빠짐의 순간을 위한 약입니다.","start":343.0,"end":354.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0002-0018","text":"그 순간을 지나쳐버리면 뒤늦게 후회할 수도 있어요.","start":354.0,"end":359.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0000","text":"후회할 수도 있어요.","start":358,"end":360.0,"timestamp_status":null,"boundary_overlap":true},{"id":"0003-0001","text":"좋은 보호자는 강아지가 아프다고 말하기 전에 그걸 먼저 알아차리는 사람입니다.","start":360.0,"end":368.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0002","text":"비타민이라고 가볍게 여기지 마세요.","start":368.0,"end":372.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0003","text":"어떤 아이에게는 다시 일어설 수 있는 마지막 손잡이일 수도 있습니다.","start":372.0,"end":379.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0004","text":"감사합니다.","start":383.0,"end":385.0,"timestamp_status":null,"boundary_overlap":false},{"id":"0003-0005","text":"시청해주셔서 감사합니다.","start":388.0,"end":393.0,"timestamp_status":null,"boundary_overlap":false}],"timestamp_warnings":[]},"video_assessment":{"suggested":{"relevance_status":"exclude","exclusion_reason":"non_cancer_pet_content","content_scope":"non_cancer_pet_content","content_scope_candidates":["non_cancer_pet_content"],"content_language":"ko","actor_type":"unclear","actor_evidence":[{"source":"title","quote":"동네수의사가 절대 비밀로 하는","segment_id":"NA_not_applicable"}],"contains_commercial_content":"true","commercial_type":["product_name_or_brand_mention_only"],"commercial_evidence":[{"source":"description","quote":"벤포티아민(Benfotiamine),","segment_id":"NA_not_applicable"},{"source":"description","quote":"병원에선 약값만 40,000원! 보호자가 직접 약국에서 사면 100원!","segment_id":"NA_not_applicable"},{"source":"description","quote":"벤포티아민(Benfotiamine)","segment_id":"NA_not_applicable"},{"source":"description","quote":"보호자가 직접 약국에서 사면 100원","segment_id":"NA_not_applicable"}],"classification_reason":"배치 1: 강아지의 비타민·벤포티아민과 무기력·식욕부진을 다루는 반려동물 건강 콘텐츠이지만 암·종양 관련성이 없습니다. 설명란에는 벤포티아민 제품과 가격 차이를 강조하는 홍보성 제품 언급이 확인되나, 직접 판매 링크나 제휴 정보는 확인되지 않습니다.\n배치 2: 강아지의 무기력과 벤포티아민을 다루는 반려동물 건강 콘텐츠로, 암·종양 영양 콘텐츠에는 해당하지 않습니다.